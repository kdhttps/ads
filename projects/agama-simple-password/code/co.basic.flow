Flow co.basic
     Basepath ""
Log "@info info"
Match matchT to
     case1
          // case1 log
          Log "@info case1 log"
     a[0]
          Log "@info a array log"
     a
          Log "@info only a log"
     "1"
          Log "@info string 1 log"
Otherwise
     Log "@info otherwise log"
// continue log
Log "@info continue log"